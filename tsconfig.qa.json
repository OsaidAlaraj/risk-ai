{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": ".qa-build",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmitOnError": true
  },
  "include": [
    "src/audit/**/*.ts",
    "src/data/**/*.ts",
    "src/engine/**/*.ts",
    "src/evidence/**/*.ts",
    "src/legal/**/*.ts",
    "src/report/**/*.ts",
    "src/testing/**/*.ts",
    "src/qa/**/*.ts"
  ]
}
